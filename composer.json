{
  "name": "saucebase/auth",
  "description": "Sign-in for Saucebase: login, registration, social login, magic links, password reset and user admin.",
  "type": "saucebase-module",
  "license": "MIT",
  "version": "v3.5.0",
  "authors": [
    {
      "name": "Saucebase",
      "email": "hello@saucebase.dev"
    }
  ],
  "extra": {
    "saucebase": {
      "frameworks": [
        "vue",
        "react"
      ]
    },
    "laravel": {
      "providers": [
        "Modules\\Auth\\Providers\\AuthServiceProvider"
      ],
      "aliases": {}
    }
  },
  "autoload": {
    "psr-4": {
      "Modules\\Auth\\": "src/",
      "Modules\\Auth\\Database\\Factories\\": "database/factories/",
      "Modules\\Auth\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\Auth\\Tests\\": "tests/"
    }
  },
  "require": {
    "saucebase/core": "^2.7",
    "laravel/socialite": "^5.31",
    "stechstudio/filament-impersonate": "^5.6.1",
    "laravel/passkeys": "^0.2.1"
  },
  "minimum-stability": "stable"
}
